# توكن البوت من @BotFather (مطلوب)
BOT_TOKEN=

# رابط MongoDB (مطلوب) — تكدر تسوي قاعدة مجانية من MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tamreer

# أرقام حساباتك بتيليجرام (مفصولة بفاصلة) علمود تكدر تضيف وتحذف كلمات من القاموس
# تعرف رقمك من البوت @userinfobot
BOT_ADMIN_IDS=

# الاسم الي يطلع أسفل الصور
BRAND_NAME=CLOVER

# إعدادات اللعبة (اختياري)
MIN_PLAYERS=2
MAX_PLAYERS=20
TURNS_PER_LEVEL=6

# ───── اختياري ومدفوع: فحص إضافي بالذكاء الاصطناعي ─────
# بدونه البوت يفحص الكلمات بالقاموس العربي المدمج مجاناً
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_FAIL_OPEN=true
