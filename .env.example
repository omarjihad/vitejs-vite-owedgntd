# توكن البوت من @BotFather
BOT_TOKEN=

# رابط MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tamreer

# مفتاح Claude API لفحص الكلمات بالذكاء الاصطناعي
ANTHROPIC_API_KEY=
# الموديل المستخدم لفحص الكلمات (اختياري)
AI_MODEL=claude-opus-5
# إذا فشل الاتصال بالذكاء الاصطناعي: true = تُقبل الكلمة، false = تُرفض
AI_FAIL_OPEN=true

# الاسم الي يطلع أسفل الصور
BRAND_NAME=CLOVER

# إعدادات اللعبة (اختياري)
MIN_PLAYERS=2
MAX_PLAYERS=20
TURNS_PER_LEVEL=6
